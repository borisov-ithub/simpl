{
  "name": "simpl",
  "displayName": "Simpl",
  "description": "Подсветка синтаксиса и сниппеты для учебного языка Simpl",
  "version": "3.1.1",
  "publisher": "your-name",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages"],
