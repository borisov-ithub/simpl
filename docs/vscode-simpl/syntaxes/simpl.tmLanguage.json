{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Simpl",
  "scopeName": "source.simpl",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#function-declaration" },
    { "include": "#let-declaration" },
    { "include": "#import" },
    { "include": "#keywords" },
    { "include": "#echo" },
    { "include": "#builtin-modules" },
    { "include": "#builtin-globals" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.simpl",
          "match": "--.*$"
        }
      ]
    },
    "import": {
      "patterns": [
        {
          "match": "\\b(import)\\s+([A-Za-z_][A-Za-z0-9_]*|\\.\\.?)((?:/[A-Za-z_][A-Za-z0-9_]*)*)",
          "captures": {
            "1": { "name": "keyword.control.import.simpl" },
            "2": { "name": "entity.name.namespace.simpl" },
            "3": { "name": "entity.name.namespace.path.simpl" }
          }
        },
        {
          "match": "\\b(import)\\s+(\"(?:[^\"\\\\]|\\\\.)*\")",
          "captures": {
            "1": { "name": "keyword.control.import.simpl" },
            "2": { "name": "string.quoted.double.path.simpl" }
          }
        },
        {
          "name": "keyword.control.import.simpl",
          "match": "\\bimport\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.simpl",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.simpl",
              "match": "\\\\[nt\"'\\\\$]"
            },
            {
              "name": "meta.interpolation.simpl",
              "begin": "\\$\\(",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.simpl" }
              },
              "end": "\\)",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.simpl" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.simpl",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.simpl",
              "match": "\\\\[nt\"'\\\\$]"
            },
            {
              "name": "meta.interpolation.simpl",
              "begin": "\\$\\(",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.simpl" }
              },
              "end": "\\)",
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.simpl" }
              },
              "patterns": [
                { "include": "$self" }
              ]
            }
          ]
        }
      ]
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.simpl",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.oct.simpl",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.bin.simpl",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.decimal.simpl",
          "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
        }
      ]
    },

    "function-declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.control.let.simpl" },
            "2": { "name": "entity.name.function.simpl" },
            "3": { "name": "punctuation.section.parameters.begin.simpl" }
          }
        },
        {
          "match": "(\\\\)\\s*(\\()",
          "captures": {
            "1": { "name": "keyword.operator.lambda.simpl" },
            "2": { "name": "punctuation.section.parameters.begin.simpl" }
          }
        }
      ]
    },

    "let-declaration": {
      "patterns": [
        {
          "match": "\\b(let)\\s+(\\^)?\\s*([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.let.simpl" },
            "2": { "name": "keyword.operator.mutability.simpl" },
            "3": { "name": "variable.other.declaration.simpl" }
          }
        }
      ]
    },

    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.simpl",
          "match": "\\b(if|then|elseif|else|end|for|in|do|loop|break|continue|match|return|and|or|not|use|as|import|type)\\b"
        }
      ]
    },

    "echo": {
      "patterns": [
        {
          "name": "keyword.other.echo.simpl",
          "match": "\\becho\\b"
        },
        {
          "name": "keyword.other.echo.newline.simpl",
          "match": "\\becho\\."
        }
      ]
    },

    "builtin-modules": {
      "patterns": [
        {
          "match": "\\b(string|math|tuple|struct|iter|file|datetime)\\b",
          "captures": {
            "1": { "name": "support.class.module.simpl" }
          }
        }
      ]
    },

    "builtin-globals": {
      "patterns": [
        {
          "name": "support.function.builtin.simpl",
          "match": "\\b(len|str|num|range|input|bin|hex|oct|ord|chr)\\b"
        },
        {
          "match": "\\b(len|str|num|range|input|bin|hex|oct|ord|chr)\\b",
          "captures": {
            "1": { "name": "support.function.builtin.simpl" }
          }
        }
      ]
    },

    "constants": {
      "patterns": [
        {
          "name": "constant.language.simpl",
          "match": "\\b(true|false|nil)\\b"
        }
      ]
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.simpl",
          "match": "\\+\\+|==|!=|<=|>=|->"
        },
        {
          "name": "keyword.operator.arithmetic.simpl",
          "match": "\\+|-|\\*|/|%"
        },
        {
          "name": "keyword.operator.comparison.simpl",
          "match": "==|!=|<=|>=|<|>"
        },
        {
          "name": "keyword.operator.assignment.simpl",
          "match": "="
        },
        {
          "name": "keyword.operator.mutability.simpl",
          "match": "\\^"
        },
        {
          "name": "keyword.operator.lambda.simpl",
          "match": "\\\\"
        }
      ]
    },

    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.comma.simpl",
          "match": ","
        },
        {
          "name": "punctuation.accessor.dot.simpl",
          "match": "\\."
        },
        {
          "name": "punctuation.section.brackets.simpl",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.braces.simpl",
          "match": "[\\{\\}]"
        },
        {
          "name": "punctuation.section.parens.simpl",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.colon.simpl",
          "match": ":"
        }
      ]
    }
  }
}