{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Simpl",
    "scopeName": "source.simpl",
    "patterns": [
      { "include": "#comments" },
      { "include": "#strings" },
      { "include": "#numbers" },
      { "include": "#keywords" },
      { "include": "#constants" },
      { "include": "#operators" },
      { "include": "#functions" },
      { "include": "#echo" }
    ],
    "repository": {
      "comments": {
        "patterns": [
          {
            "name": "comment.line.double-dash.simpl",
            "match": "--.*$"
          }
        ]
      },
      "strings": {
        "patterns": [
          {
            "name": "string.quoted.double.simpl",
            "begin": "\"",
            "end": "\"",
            "patterns": [
              {
                "name": "constant.character.escape.simpl",
                "match": "\\\\."
              },
              {
                "name": "meta.interpolation.simpl",
                "begin": "\\$\\(",
                "end": "\\)",
                "patterns": [
                  { "include": "#numbers" },
                  { "include": "#operators" }
                ]
              }
            ]
          }
        ]
      },
      "numbers": {
        "patterns": [
          {
            "name": "constant.numeric.simpl",
            "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?\\b"
          }
        ]
      },
      "keywords": {
        "patterns": [
          {
            "name": "keyword.control.simpl",
            "match": "\\b(let|if|then|elseif|else|end|for|in|do|loop|break|continue|match|return|and|or|not)\\b"
          }
        ]
      },
      "constants": {
        "patterns": [
          {
            "name": "constant.language.simpl",
            "match": "\\b(true|false|nil)\\b"
          }
        ]
      },
      "operators": {
        "patterns": [
          {
            "name": "keyword.operator.simpl",
            "match": "(\\+\\+|==|!=|<=|>=|->|\\^|\\\\|\\+|-|\\*|/|%|=|<|>|\\[|\\]|\\{||\\}|\\(|\\)|,|\\.|:)"
          }
        ]
      },
      "functions": {
        "patterns": [
          {
            "name": "entity.name.function.simpl",
            "match": "\\b(let\\s+)([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\("
          }
        ]
      },
      "echo": {
        "patterns": [
          {
            "name": "support.function.builtin.simpl",
            "match": "\\b(echo\\.?|len|type|str|num|range)\\b"
          }
        ]
      }
    }
  }